# External target database used by telemetry-daemon.
# For Supabase on IPv4-only networks, use the Shared Pooler connection string
# from Project Settings > Database > Connection string > Session mode.
TARGET_DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres?sslmode=require
TARGET_DATABASE_NAME=my-real-target
TARGET_DATABASE_PREFER_IPV4=true
